                    "id": "90bab830-bf80-4391-acf0-af8ff67d73e1",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "booked",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "booked"
