    {
      "id": "57592c09-3f92-43ec-a407-f893b38f6105",
      "position": [
        260,
        200
      ],
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ====== EDIT THESE (placeholders only. Secrets live in n8n Credentials, not here) ======\n// Keep the same values in all three BOXX workflows.\nconst fiveTemplates = ['d-REPLACE_1', 'd-REPLACE_2', 'd-REPLACE_3', 'd-REPLACE_4', 'd-REPLACE_5']\nreturn [{ json: {\n  sheetId: 'REPLACE_WITH_GOOGLE_SHEET_ID',\n  siteUrl: 'https://boxxautomations.space',\n  frameworkUrl: 'https://boxxautomations.space/BOXX-Website-Conversion-Framework.pdf',\n  calendlyUrl: 'https://calendly.com/kaleellawrenceboxx/discovery-call',\n  fromEmail: 'REPLACE_VERIFIED_SENDER@yourdomain.com',\n  fromName: 'Kaleel at BOXX',\n  replyTo: 'REPLACE_REPLY_TO@yourdomain.com',\n  notifyEmail: 'kaleellawrenceboxx@gmail.com',\n  mailingAddress: 'REPLACE: BOXX Automations, street address, Vaughan, ON, Canada',\n  asmGroupId: 0, // SendGrid unsubscribe group ID (number)\n  // Nurture timing: days after Email 1 for Emails 2,3,4,5. Change here only.\n  cadenceDays: [2, 4, 7, 10],\n  resendAfterDays: 30,\n  // Booked-call reminders (hours before the call)\n  dayBeforeHours: 24,\n  sameDayHours: 3,\n  completedAfterHours: 1,\n  // SendGrid dynamic template IDs. One 5-email list per path (can all point to the same 5 for now).\n  templates: {\n    WEBSITE: fiveTemplates.slice(),\n    EMAIL: fiveTemplates.slice(),\n    BOTH: fiveTemplates.slice(),\n    confirm: 'd-REPLACE_CONFIRM',\n    reminder24: 'd-REPLACE_REMINDER_24H',\n    reminderDay: 'd-REPLACE_REMINDER_SAMEDAY',\n  },\n  subjects: [\n    'Your BOXX Website Conversion Framework',\n    'Every page should ask for one thing',\n    'What fixing a homepage looks like',\n    'The proof I can show you right now',\n    'Straight answers before you decide',\n  ],\n  bookingSubjects: { confirm: 'You are booked: your BOXX call', reminder24: 'Reminder: your BOXX call is tomorrow', reminderDay: 'Your BOXX call is today' },\n} }]"
      }
    },
    {
      "id": "b58b2468-39f7-418c-9208-229a4f0b28aa",
      "position": [
        520,
        200
      ],
      "name": "Parse Calendly event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $('Calendly booking event').first().json\nconst pl = j.payload || (j.body && j.body.payload) || {}\nconst ev = j.event || (j.body && j.body.event) || ''\nconst se = pl.scheduled_event || {}\nreturn [{ json: {\n  type: ev === 'invitee.created' ? 'created' : ev === 'invitee.canceled' ? 'canceled' : 'ignore',\n  email: String(pl.email || '').toLowerCase().trim(), name: pl.name || '',\n  eventUri: se.uri || pl.event || '', startTime: se.start_time || '',\n} }]"
      }
    },
    {
      "id": "35fa0813-7730-4c80-9a82-27ffc08ec7f0",
      "position": [
        780,
        200
      ],
      "name": "Find lead by email",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets account"
        }
      },
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').first().json.sheetId }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "email",
              "lookupValue": "={{ $('Parse Calendly event').first().json.email }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f3cb13c7-fdcf-4898-b2a3-847c37e65902",
      "position": [
        1040,
        200
      ],
      "name": "Decide booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $('Parse Calendly event').first().json\nconst rows = $input.all().map(i => i.json).filter(r => r && r.email)\nconst ex = rows.find(r => String(r.email).toLowerCase().trim() === p.email)\nconst T = x => String(x == null ? '' : x).toUpperCase() === 'TRUE'\nconst iso = new Date().toISOString()\nif (p.type === 'ignore' || !p.email) return [{ json: { action: 'ignore' } }]\nif (!ex) return [{ json: { action: 'unmatched', p } }]\nconst isClient = String(ex.client_status || '').toUpperCase() === 'ACTIVE'\nif (p.type === 'created') {\n  if (ex.calendly_event_id === p.eventUri && T(ex.calendly_booked)) return [{ json: { action: 'duplicate' } }]\n  const row = { email: ex.email, calendly_booked: 'TRUE', calendly_event_id: p.eventUri, call_date: p.startTime,\n    nurture_status: 'STOPPED', stop_reason: 'booked', client_status: isClient ? 'ACTIVE' : 'CALL_BOOKED',\n    reminder_24h_sent: 'FALSE', reminder_day_sent: 'FALSE', updated_at: iso }\n  return [{ json: { action: 'booked', row, lead_id: ex.lead_id, email: ex.email, first_name: String(ex.name || p.name || '').split(' ')[0], startTime: p.startTime } }]\n}\nif (ex.calendly_event_id && ex.calendly_event_id !== p.eventUri) return [{ json: { action: 'stale_cancel' } }]\nconst row = { email: ex.email, calendly_booked: 'FALSE', calendly_event_id: '', call_date: '', client_status: isClient ? 'ACTIVE' : 'CALL_CANCELLED', updated_at: iso }\nreturn [{ json: { action: 'canceled', row } }]"
      }
    },
    {
      "id": "b38f3025-eafa-416a-8ee2-417117bccea0",
      "position": [
        1300,
