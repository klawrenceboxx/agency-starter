                },
                "conditions": [
                  {
                    "id": "eeb3ace7-3bc4-4bf7-9f9a-60554335ce49",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "unmatched",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "unmatched"
            }
          ]
        },
        "options": {}
      }
